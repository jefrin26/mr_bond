# Copy to .env: cp .env.example .env (never commit .env)
PORT=3000
POLL_INTERVAL_SEC=30
SSH_TIMEOUT_MS=10000
HISTORY_MAX_POINTS=1000
HISTORY_MAX_DAYS=7

# Optional defaults (used when a server has no specific *_USER/PASS)
SSH_DEFAULT_USER=monitor
SSH_DEFAULT_PASS=changeme
SSH_DEFAULT_PORT=22
# SSH_DEFAULT_KEY_PATH=~/.ssh/id_rsa

# Per-server creds (prefix = uppercased server id, non-alphanumerics -> _)
# web1 -> password auth
WEB1_USER=monitor
WEB1_PASS=changeme

# db1 -> key auth
DB1_USER=monitor
DB1_PRIVATE_KEY_PATH=~/.ssh/id_rsa
DB1_PASSPHRASE=
